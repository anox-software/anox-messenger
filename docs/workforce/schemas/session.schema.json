{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anox.software/schemas/workforce/session.schema.json",
  "title": "B-028 Session Evidence Manifest",
  "description": "Machine-readable evidence manifest for a remediation or audit session. Sessions are data; a generic ingest validator consumes them. Fail closed on unknown fields.",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "security_class",
    "authorized_task_id",
    "covered_units",
    "artifacts",
    "required_retests",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^B028-SES-v[0-9]+$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]+$"
    },
    "security_class": {
      "type": "string",
      "enum": ["S0", "S1", "S2", "S3", "S4"]
    },
    "authorized_task_id": {
      "type": "string",
      "pattern": "^ANOX-TASK-[A-Z0-9-]+$"
    },
    "covered_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(MSC-UNIT-[0-9]+|ANOX-[A-Z0-9-]+)$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": ["report", "evidence", "manifest", "log", "decision", "other"]
          }
        },
        "additionalProperties": false
      }
    },
    "required_retests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit", "level", "binding"],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "enum": ["E1", "E2", "E3", "E4"]
          },
          "binding": {
            "type": "string",
            "enum": ["independent_retest", "ci_verdict", "human_attestation"]
          },
          "satisfied_by": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SATISFIED", "FAILED"]
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["base_sha", "delivery_branch"],
      "properties": {
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "delivery_branch": {
          "type": "string",
          "minLength": 1
        },
        "merge_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
