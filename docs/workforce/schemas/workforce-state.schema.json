{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anox.software/schemas/workforce/workforce-state.schema.json",
  "title": "B-027 Workforce State",
  "description": "Canonical machine-readable current state of the ANOX AI workforce.",
  "type": "object",
  "required": [
    "schema_version",
    "authority_version",
    "current_gate",
    "active_roles",
    "blocked_tasks",
    "authorized_tasks",
    "current_writer",
    "pending_human_remote_actions",
    "latest_decision_id",
    "latest_finding_id",
    "latest_run_id",
    "latest_work_candidate_id"
  ],
  "$defs": {
    "mergeStateBlock": {
      "type": "object",
      "properties": {
        "described_head": {"type": "string"},
        "current_gate": {"type": "string"},
        "current_writer": {
          "type": ["object", "null"],
          "properties": {
            "task_id": {"type": "string"},
            "role_id": {"type": "string"},
            "branch": {"type": "string"}
          },
          "required": ["task_id", "role_id", "branch"]
        },
        "next_phase": {"type": "string"},
        "current_task": {"type": "string"},
        "active_task": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "acceptanceGate": {
      "type": "object",
      "properties": {
        "gate_id": {"type": "string"},
        "title": {"type": "string"},
        "status": {"type": "string"},
        "result": {"type": "string"},
        "work_candidate_id": {"type": "string"},
        "rationale": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "authority_version": {
      "type": "string"
    },
    "current_gate": {
      "type": "string"
    },
    "active_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ROLE-(0[0-9][0-9]|1[0-9])$"
      }
    },
    "blocked_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ANOX-TASK-[A-Z0-9]+$"
      }
    },
    "authorized_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ANOX-TASK-[A-Z0-9]+$"
      }
    },
    "current_writer": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^ANOX-TASK-[A-Z0-9]+$"
        },
        "role_id": {
          "type": "string",
          "pattern": "^ROLE-(0[0-9][0-9]|1[0-9])$"
        },
        "branch": {
          "type": "string"
        }
      },
      "required": ["task_id", "role_id", "branch"]
    },
    "pending_human_remote_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "action", "role_id"],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^ANOX-TASK-[A-Z0-9]+$"
          },
          "action": {
            "type": "string"
          },
          "role_id": {
            "type": "string",
            "pattern": "^ROLE-(0[0-9][0-9]|1[0-9])$"
          }
        }
      }
    },
    "latest_decision_id": {
      "type": ["string", "null"],
      "pattern": "^ANOX-DECISION-[A-Z0-9]+$"
    },
    "latest_finding_id": {
      "type": ["string", "null"],
      "pattern": "^ANOX-(FINDING|MAINARCH|LEGACY|WORKFORCE|SECURITY)-[A-Z0-9-]+$"
    },
    "latest_run_id": {
      "type": ["string", "null"],
      "pattern": "^ANOX-RUN-[A-Z0-9]+$"
    },
    "latest_work_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^ANOX-WORK-[A-Z0-9]+$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_branch": {"type": "string"},
    "delivery_branch": {"type": "string"},
    "described_head": {"type": "string"},
    "pre_merge_state": {"$ref": "#/$defs/mergeStateBlock"},
    "post_merge_state": {"$ref": "#/$defs/mergeStateBlock"},
    "effective_state": {"$ref": "#/$defs/mergeStateBlock"},
    "final_operational_handoff_acceptance_gate": {"$ref": "#/$defs/acceptanceGate"},
    "product_development_state": {"type": "string"},
    "next_phase": {"type": "string"},
    "main_architecture_audit": {"type": "string"},
    "main_architecture_remediation_phase": {"type": "string"},
    "workforce_architecture_audit": {"type": "string"},
    "legacy_audit_set_status": {"type": "string"},
    "final_pre_product_audit": {"type": "object"}
  },
  "additionalProperties": false
}
