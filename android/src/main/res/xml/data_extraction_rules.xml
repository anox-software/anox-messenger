<?xml version="1.0" encoding="utf-8"?>
<!--
  B-025: anoX private application data must never enter Android cloud backup
  or device-to-device transfer. This rule excludes all application-private
  storage domains from both backup and D2D transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
