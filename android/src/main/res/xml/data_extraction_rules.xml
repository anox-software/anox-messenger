<?xml version="1.0" encoding="utf-8"?>
<!--
  B-025: anoX private application data must never enter Android cloud backup
  or device-to-device transfer. This rule fail-closed excludes all
  application-private storage domains (including cloud, device, and external)
  from both backup and D2D transfer.

  For Android 11 and below the manifest already declares
  android:allowBackup="false", which disables full app backup to Google servers.
  dataExtractionRules are only consulted on Android 12+ (API 31+) and cover
  both Google cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
